# SAP Document Information Extraction API Configuration

# Destination name (configured in BTP Cockpit or local .cdsrc-private.json)
DOCAI_DESTINATION=docai-destination

# Schema Version ID (GUID) - Get from DocAI UI or SchemaService API
# This is the ID of the active SchemaVersion, not the schema name
DOCAI_SCHEMA_VERSION_ID=<your-schema-version-guid>

# Service URL for CLI testing
SERVICE_URL=http://localhost:4004

# Validation Settings
VALIDATION_CONFIDENCE_THRESHOLD=0.85
