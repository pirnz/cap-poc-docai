# Environment Variables

# DocAI Configuration
DOCAI_DESTINATION=docai-destination

# Schema Version ID (GUID) - Get this from DocAI UI or SchemaService API
# Query: GET /SchemaService/SchemaVersions?$filter=isActive eq true
DOCAI_SCHEMA_VERSION_ID=<your-schema-version-guid>

# Optional: Override DocAI credentials (if not using destination)
# DOCAI_CLIENT_ID=<client-id>
# DOCAI_CLIENT_SECRET=<client-secret>
# DOCAI_URL=https://<region>.aiservices.sap.com

# Validation Configuration
VALIDATION_CONFIDENCE_THRESHOLD=0.85

# Development
DEBUG=true
