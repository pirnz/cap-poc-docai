{
  "name": "cap-poc-docai",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@sap-cloud-sdk/connectivity": "^3",
    "@sap-cloud-sdk/http-client": "^3",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "adm-zip": "^0.5",
    "body-parser": "^1",
    "cookie-parser": "^1.4.7",
    "csurf": "^1.11.0",
    "express": "^4",
    "form-data": "^4",
    "mailparser": "^3",
    "@cap-js/sqlite": "^2"
  },
  "devDependencies": {
    "@sap/cds-dk": "^9",
    "axios": "^1.18.1",
    "dotenv": "^17.4.2",
    "glob": "^10.5.0"
  },
  "scripts": {
    "start": "cds-serve",
    "test:workbench": "node test/test-workbench.js",
    "test:workbench:headless": "HEADLESS=true node test/test-workbench.js"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "impl": "@cap-js/sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      },
      "docai-destination": {
        "kind": "odata",
        "credentials": {
          "destination": "docai-destination"
        }
      },
      "s4hana-destination": {
        "kind": "odata",
        "credentials": {
          "destination": "s4hana-destination"
        }
      },
      "[production]": {
        "auth": "xsuaa"
      },
      "destinations": true,
      "html5-repo": true,
      "workzone": true
    },
    "fiori": {
      "lean_draft": true
    }
  },
  "sapux": [
    "app/batches",
    "app/documents"
  ]
}
